# Phase 1/2: Web scraping (optional)
# Third-source phone number cross-check (BBB alternative, or omit to skip)
YELP_API_KEY=

# Carrier-type lookup for mobile-number rejection heuristic
NUMVERIFY_API_KEY=

# Phase 3: Ollama configuration for local LLM script generation
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Phase 3: Deerflow workflow orchestration
DEERFLOW_API_URL=http://localhost:8080
DEERFLOW_WORKFLOW_ID=agentic-priming-loop

# Phase 3: Scoring backend (manual or http)
# For manual: user provides scores via CLI
# For http: set API endpoint and optional auth key
AGENTIC_PRIMING_SCORER=manual
# AGENTIC_PRIMING_API_URL=
# AGENTIC_PRIMING_API_KEY=
