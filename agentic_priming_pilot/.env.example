# Phase 1/2: Web scraping (optional)
# Third-source phone number cross-check (BBB alternative, or omit to skip)
YELP_API_KEY=

# Carrier-type lookup for mobile-number detection (optional).
# If not set, uses free area-code heuristic (~90% accurate).
# If set, API is preferred with automatic fallback to heuristic.
NUMVERIFY_API_KEY=

# Phase 3: Ollama configuration for local LLM script generation
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Phase 3: independent quality gate for Ollama-drafted scripts (optional).
# Ollama never scores its own work — if set, every draft is scored by Claude
# and rewritten by Claude when it scores below QUALITY_GATE_THRESHOLD.
# If unset, drafts are used as-is with no independent review.
ANTHROPIC_API_KEY=
QUALITY_GATE_THRESHOLD=70

# Phase 3: Deerflow workflow orchestration
DEERFLOW_API_URL=http://localhost:8080
DEERFLOW_WORKFLOW_ID=agentic-priming-loop

# Phase 3: Scoring backend (manual or http)
# For manual: user provides scores via CLI
# For http: set API endpoint and optional auth key
AGENTIC_PRIMING_SCORER=manual
# AGENTIC_PRIMING_API_URL=
# AGENTIC_PRIMING_API_KEY=
